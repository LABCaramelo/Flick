# Porta do servidor de API (o Vite faz proxy de /api e /media para cá)
API_PORT=8787

# ---- Agente de chat (OpenAI) ----
OPENAI_API_KEY=
# Modelo usado pelo agente. Precisa suportar tool calling e imagens.
OPENAI_MODEL=gpt-5
# Opcional: endpoint compatível com OpenAI
# OPENAI_BASE_URL=

# ---- Geração de mídia (Higgsfield API & MCP) ----
# Credenciais oficiais da Higgsfield (key-id:key-secret)
HF_CREDENTIALS=
# Servidor MCP oficial (OAuth). Conecte em Configurações > Provedores.
HIGGSFIELD_MCP_URL=https://mcp.higgsfield.ai/mcp

# URL pública deste servidor (ex.: túnel cloudflared/ngrok).
# PUBLIC_BASE_URL=https://seu-tunel.trycloudflare.com

# Provedor de geração: "higgsfield" (padrão) ou "mock" (offline, sem custo)
GENERATION_PROVIDER=higgsfield

# ---- Banco de dados (Supabase, projeto LAB Caramelo) ----
SUPABASE_URL=https://fzhzpzxsttflgtassyex.supabase.co
# Painel do Supabase > Project Settings > API Keys > service_role (secret).
SUPABASE_SERVICE_ROLE_KEY=

# ---- Cloudflare R2 Storage ----
CLOUDFLARE_ACCOUNT_ID=0b85653a3fda604ea469fb2723afa5cb
R2_BUCKET_NAME=umcaracaramelo
R2_PUBLIC_DOMAIN=https://media.umcaracaramelo.com.br
# Opcional: chaves S3 R2 para upload via SDK S3 (ou Cloudflare API Token)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

{
  "name": "claquete",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de cinema com IA: canvas infinito, agente, set 3D e editor de vídeo. Geração via Higgsfield MCP, agente via OpenAI.",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n server,web -c magenta,cyan \"npm:dev:server\" \"npm:dev:web\"",
    "dev:server": "tsx watch --clear-screen=false server/index.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "cross-env NODE_ENV=production tsx server/index.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "higgsfield:example": "tsx index.ts"
  },
  "dependencies": {
    "@higgsfield/client": "^0.2.6",
    "@modelcontextprotocol/sdk": "^1.32.1",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@tiptap/extension-placeholder": "^2.27.3",
    "@tiptap/pm": "^2.27.3",
    "@tiptap/react": "^2.27.3",
    "@tiptap/starter-kit": "^2.27.3",
    "dotenv": "^16.6.1",
    "express": "^4.22.3",
    "immer": "^10.2.0",
    "lucide-react": "^1.58.0",
    "multer": "^2.4.0",
    "openai": "^5.23.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.4",
    "remark-gfm": "^4.0.1",
    "three": "^0.180.0",
    "zod": "^3.25.76",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@types/express": "^4.17.25",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "cross-env": "^7.0.3",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.4"
  }
}
